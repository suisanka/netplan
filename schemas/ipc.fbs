namespace PENetplan.Ipc;

enum ErrorCode : ubyte {
  None = 0,
  InvalidRequest = 1,
  InvalidConfig = 2,
  Unsupported = 3,
  PermissionDenied = 4,
  NotFound = 5,
  Internal = 6
}

enum CapabilityState : ubyte {
  Unavailable = 0,
  ReadOnly = 1,
  DryRun = 2,
  Available = 3
}

enum ConfigFormat : ubyte {
  Auto = 0,
  Yaml = 1,
  Json = 2
}

enum ConfigAction : ubyte {
  Validate = 0,
  Plan = 1,
  Apply = 2
}

enum OperationRisk : ubyte {
  ReadOnly = 0,
  Low = 1,
  Connectivity = 2,
  Destructive = 3
}

enum JobState : ubyte {
  Queued = 0,
  Running = 1,
  Succeeded = 2,
  Failed = 3,
  RolledBack = 4
}

table PingRequest {}

table PingResponse {
  daemon_version:string (required);
  protocol_version:uint;
}

table CapabilitiesRequest {}

table Capability {
  name:string (required);
  state:CapabilityState;
  reason:string;
}

table CapabilitiesResponse {
  capabilities:[Capability] (required);
}

table ListAdaptersRequest {}

table IpAddress {
  address:string (required);
  prefix_length:ubyte;
}

table Adapter {
  if_index:uint;
  name:string (required);
  description:string;
  guid:string;
  mac_address:string;
  status:string;
  hardware:bool;
  ipv4:[IpAddress];
  ipv6:[IpAddress];
}

table ListAdaptersResponse {
  adapters:[Adapter] (required);
}

table ConfigRequest {
  action:ConfigAction;
  format:ConfigFormat;
  document:[ubyte] (required);
  dry_run:bool = true;
}

table ValidationIssue {
  path:string;
  message:string (required);
}

table ValidateConfigResponse {
  valid:bool;
  issues:[ValidationIssue] (required);
}

table Operation {
  id:string (required);
  capability:string (required);
  summary:string (required);
  risk:OperationRisk;
  target:string;
}

table PlanConfigResponse {
  operations:[Operation] (required);
}

table ApplyConfigResponse {
  job_id:string (required);
  state:JobState;
  operations:[Operation] (required);
}

table JobStatusRequest {
  job_id:string (required);
}

table JobStatusResponse {
  job_id:string (required);
  state:JobState;
  message:string;
}

table DaemonStatusRequest {}

table DaemonStatusResponse {
  daemon_version:string (required);
  protocol_version:uint;
  started_at_unix_ms:ulong;
  uptime_ms:ulong;
  total_jobs:uint;
  queued_jobs:uint;
  running_jobs:uint;
  succeeded_jobs:uint;
  failed_jobs:uint;
  rolled_back_jobs:uint;
}

table ListJobsRequest {
  has_state:bool;
  state:JobState;
  limit:uint = 100;
}

table JobSummary {
  job_id:string (required);
  state:JobState;
  message:string;
  created_at_unix_ms:ulong;
  updated_at_unix_ms:ulong;
}

table ListJobsResponse {
  jobs:[JobSummary] (required);
  total:uint;
}

table NetworkStatusRequest {}

table WifiStatusRequest {
  has_if_index:bool;
  if_index:uint;
}

table WifiScanRequest {
  has_if_index:bool;
  if_index:uint;
  refresh:bool = true;
  timeout_ms:uint = 4000;
}

table WifiInterfaceStatus {
  if_index:uint;
  name:string (required);
  guid:string;
  state:string (required);
  profile_name:string;
  ssid:string;
  ssid_hex:string;
  has_signal_quality:bool;
  signal_quality:ubyte;
  has_security_enabled:bool;
  security_enabled:bool;
  authentication:string;
  cipher:string;
  has_rx_rate_kbps:bool;
  rx_rate_kbps:uint;
  has_tx_rate_kbps:bool;
  tx_rate_kbps:uint;
}

table WifiNetwork {
  interface_if_index:uint;
  interface_name:string (required);
  ssid:string (required);
  ssid_hex:string (required);
  profile_name:string;
  signal_quality:ubyte;
  security_enabled:bool;
  authentication:string (required);
  cipher:string (required);
  connectable:bool;
  has_not_connectable_reason:bool;
  not_connectable_reason:uint;
  connected:bool;
  bss_count:uint;
}

table NetworkStatusResponse {
  captured_at_unix_ms:ulong;
  adapters:[Adapter] (required);
  wifi_interfaces:[WifiInterfaceStatus] (required);
  wifi_error:string;
}

table WifiStatusResponse {
  interfaces:[WifiInterfaceStatus] (required);
}

table WifiScanResponse {
  refreshed:bool;
  networks:[WifiNetwork] (required);
}

table ErrorResponse {
  code:ErrorCode;
  message:string (required);
}

union Payload {
  PingRequest,
  PingResponse,
  CapabilitiesRequest,
  CapabilitiesResponse,
  ListAdaptersRequest,
  ListAdaptersResponse,
  ConfigRequest,
  ValidateConfigResponse,
  PlanConfigResponse,
  ApplyConfigResponse,
  JobStatusRequest,
  JobStatusResponse,
  ErrorResponse,
  DaemonStatusRequest,
  DaemonStatusResponse,
  ListJobsRequest,
  ListJobsResponse,
  NetworkStatusRequest,
  NetworkStatusResponse,
  WifiStatusRequest,
  WifiStatusResponse,
  WifiScanRequest,
  WifiScanResponse
}

table Envelope {
  protocol_version:uint = 1;
  request_id:ulong;
  payload:Payload;
}

root_type Envelope;
file_identifier "PNET";
file_extension "pnet";
